        <mxCell id="comp_a" value="&lt;b&gt;COMPONENTE A: Google Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Bucket privado:&lt;/b&gt; grupo3-archivos&lt;br&gt;Clase: Standard | Acceso: Uniforme&lt;br&gt;Prevención de acceso público: ACTIVADA&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;productos/2026/&amp;lt;uuid&amp;gt;.jpg&lt;/font&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2.5;fontSize=12;fontColor=#1A365D;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
